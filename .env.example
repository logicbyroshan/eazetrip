# ==========================================
# EazeTrip (ExploreEase) Environment Configuration
# ==========================================

# Server Configuration
PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4174,http://127.0.0.1:4174

# Security Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_SENSITIVE_MAX=20

# ==========================================
# RAZORPAY PAYMENT GATEWAY CREDENTIALS
# ==========================================
# Get your API Keys from Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
# Test Mode Key Example: rzp_test_xxxxxxxxxxxxxx
# Live Mode Key Example: rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# (Optional) Razorpay Webhook Secret for real-time payment notifications
# Configured in: Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Client Vite Configuration
VITE_API_URL=http://localhost:5001
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# ==========================================
# GOOGLE OAUTH 2.0 / SIGN-IN CREDENTIALS
# ==========================================
# Get your Google OAuth Client ID & Secret from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID (Web Application)
# 2. Add Authorized JavaScript Origins:
#    - http://localhost:4174
#    - http://localhost:5173
#    - http://127.0.0.1:4174
# 3. Paste credentials below:
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Frontend Google Client ID (automatically picked up by Vite SPA)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
