# ExploreEase (EazeTrip) Environment Configuration Example

# Server Configuration
PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4174,http://127.0.0.1:4174

# Security Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_SENSITIVE_MAX=20

# Client Configuration (used during build / Vite dev)
VITE_API_URL=http://localhost:5001
